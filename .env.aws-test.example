# On a fresh clone only, copy to .env.aws-test.local. Do not overwrite an existing configured file.
# These values intentionally do not fall back to the old .env backend.
VITE_AWS_TEST_SUPABASE_URL=https://api-prod.useadtool.ai
VITE_AWS_TEST_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_JWT_ONLY

# Browser keys are public. Never put a service-role key, JWT secret,
# database password or provider secret in a VITE_ variable.
# Build with: npm run build:aws
# Jenkins binds the key from Secret text credential adtool-aws-public-anon-key.
# This is the sole AWS backend; aws-test is only a local build-profile name.
# Deploy dist-aws-test/ contents to prodtest for limited validation, not full-app acceptance.
